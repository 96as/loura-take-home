# Optional settings. Copy to .env and edit; every value below is the default.
# Real environment variables override this file. No secrets are needed (the LLM is a fake).

# SQLite file, created on start
DB_PATH=tickets.db
# Worker tasks; each handles one ticket at a time
WORKER_COUNT=4
# Seconds an idle worker waits before looking for work again
POLL_INTERVAL_S=0.5
# Seconds a claim is valid without a heartbeat
LEASE_S=30
# Seconds between lease renewals while a worker is busy
HEARTBEAT_S=10
# Seconds before one LLM call times out
LLM_TIMEOUT_S=20
# Attempts per ticket before it is marked failed
MAX_ATTEMPTS=3
# Share of fake LLM replies that are broken on purpose (0 for a clean run)
FAKE_LLM_FAILURE_RATE=0.25
# Integer seed for the fake LLM and retry jitter; leave empty for random
FAKE_LLM_SEED=
